        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Տեղական համայնքը կարող է բարձրացնել դրույքները մինչև 10%։ Լռելյայն կիրառվում է 0%, քանի դեռ օգտատերը հավելավճար չի նշել։"
          }
        },
        "ru" : {
