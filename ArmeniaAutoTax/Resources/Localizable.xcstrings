    "rules.age.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The year of manufacture and the next %d tax years are taxed at 100%%. From the following year the tax decreases by %d percentage points each year, up to %d%%."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Թողարկման տարին և հաջորդ %d հարկային տարիները հարկվում են 100%%-ով։ Հաջորդ տարվանից հարկը տարեկան նվազում է %d տոկոսային կետով՝ մինչև %d%%։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Год выпуска и следующие %d налоговых года облагаются на 100%%. Со следующего года налог уменьшается на %d процентных пункта в год, но не более чем на %d%%."
          }
        }
      }
    },
    "rules.age.cargo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cargo and cargo-passenger vehicles are exempt from the %dth tax year following the year of manufacture."
          }
