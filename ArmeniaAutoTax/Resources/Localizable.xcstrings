    "donations.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app is designed, built and maintained by one developer. If it helps you, a tip is appreciated. Every feature stays available either way."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հավելվածը ստեղծում և պահպանում է մեկ մշակող։ Եթե այն օգտակար է ձեզ, փոքր թեյավճարը շնորհակալություն կլինի։ Բոլոր գործառույթները մնում են հասանելի։"
          }
