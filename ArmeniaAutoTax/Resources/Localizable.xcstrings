    "settings.about.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armenia Auto Tax estimates the vehicle property tax. 2026 is verified; later years are projected until an update. All data stays on this device."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armenia Auto Tax-ը գնահատում է տրանսպորտային միջոցների գույքահարկը։ 2026-ը ստուգված է, հաջորդ տարիները՝ կանխատեսված մինչև թարմացումը։ Բոլոր տվյալները մնում են սարքում։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armenia Auto Tax оценивает налог на имущество с транспортных средств. 2026 проверен; следующие годы — прогноз до обновления. Все данные остаются на устройстве."
          }
        }
      }
    },
