        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Առանց հաշվի, ամպի, գովազդի և հետևման։ Պահպանված մեքենաները, պատմությունը և փոխարժեքների պատկերները պահվում են սարքում։"
          }
        },
        "ru" : {
          "stringUnit" : {
