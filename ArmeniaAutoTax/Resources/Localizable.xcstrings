        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2026-ի ապրիլի 1-ից՝ եթե կա ԵԱՏՄ էլեկտրոնային անձնագիր, օգտագործվում է դրա հզորությունը։ Հակառակ դեպքում՝ մինչև 250 ձ. ու. ÷ 1.5, 250-ից բարձր՝ 250 ÷ 1.5 + մնացածը ÷ 2.5։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С 1 апреля 2026: если есть электронный паспорт ЕАЭС, используется его мощность. Иначе: до 250 л.с. ÷ 1.5; свыше 250 л.с.: 250 ÷ 1.5 + остаток ÷ 2.5."
          }
        }
      }
    },
    "rules.ev.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the power source in the calculator. Do not apply the adjustment twice."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ընտրեք հզորության աղբյուրը հաշվիչում։ Ուղղումը երկու անգամ մի կիրառեք։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
