    "months.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A date before the tax year means the vehicle was already owned. Liability starts on the first day of the month after acquisition and ends after the disposal month. An acquisition in November may shift payment to the next tax year. This is an estimate under Article 246."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дата до начала налогового года означает, что машина уже была в собственности. Обязательство возникает с 1-го числа месяца после приобретения и заканчивается после месяца выбытия. Приобретение в ноябре может перенести уплату на следующий налоговый год. Это оценка по статье 246."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հարկային տարվանից առաջ ամսաթիվը նշանակում է, որ մեքենան արդեն սեփականության մեջ էր։ Պարտավորությունը ծագում է ձեռքբերման ամսվան հաջորդող ամսվա 1-ից և ավարտվում է օտարման ամսից հետո։ Նոյեմբերին ձեռքբերումը կարող է վճարումը տեղափոխել հաջորդ հարկային տարի։ Սա գնահատում է՝ համաձայն 246-րդ հոդվածի։"
          }
        }
      }
    },
