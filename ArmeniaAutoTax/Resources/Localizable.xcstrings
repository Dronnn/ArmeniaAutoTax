          "stringUnit" : {
            "state" : "translated",
            "value" : "Առանց հաշվի, ամպի, գովազդի և հետևման։ Պահպանված մեքենաները, պատմությունը և փոխարժեքների պատկերները պահվում են սարքում։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без аккаунта, облака, рекламы и отслеживания. Сохранённые автомобили, история и снимки курсов хранятся локально."
          }
        }
      }
    },
