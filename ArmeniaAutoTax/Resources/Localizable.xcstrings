    "rules.extra.estimate" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is an estimated tax. The final amount is determined by the local tax authority."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ցուցադրվում է գնահատական հարկ։ Վերջնական գումարը որոշում է տեղական հարկային մարմինը։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показан оценочный налог. Окончательную сумму определяет местный орган налогового учёта."
          }
        }
      }
    },
    "rules.extra.exclusions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal benefits, shared ownership, environmental payments, insurance, penalties and tax debts are not included."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Անհատական արտոնությունները, համատեղ սեփականությունը, բնապահպանական վճարները, ապահովագրությունը, տույժերը և հարկային պարտքերը ներառված չեն։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Персональные льготы, долевая собственность, экологические платежи, страховка, пени и налоговые задолженности в расчёт не включены."
          }
        }
      }
    },
    "rules.extra.months" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partial-year calculation is proportional to the number of months. For exact months when ownership changes, see Article 246."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Թերի տարվա հաշվարկը կատարվում է ամիսների թվին համամասնորեն։ Սեփականատիրոջ փոփոխության դեպքում ճշգրիտ ամիսների համար տես 246-րդ հոդվածը։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расчёт за неполный год выполняется пропорционально числу месяцев. Для точного определения месяцев при смене владельца следует учитывать правила статьи 246."
          }
        }
      }
    },
    "rules.extra.power" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tax base for multiple traction engines is the total power. The Tax Code uses a 1.36 coefficient for kW. Do not round power arbitrarily near thresholds."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մի քանի շարժիչի հարկային բազան ընդհանուր հզորությունն է։ կՎտ-ից ձ. ու. փոխարկելիս օրենսգիրքը սահմանում է 1,36 գործակից։ Մի կլորացրեք հզորությունը շեմերի մոտ կամայականորեն։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налоговая база для нескольких тяговых двигателей — суммарная мощность. При переводе кВт в л. с. НК устанавливает коэффициент 1,36. Не округляйте мощность вблизи порогов произвольно."
          }
        }
      }
    },
    "rules.extra.surcharge" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local community may increase rates by up to 10%. The default is 0% until the user enters a surcharge."
