        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Բեռնատար և բեռնա-ուղևորատար մեքենաները ազատվում են թողարկման տարվանից հետո %d-րդ հարկային տարուց։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
