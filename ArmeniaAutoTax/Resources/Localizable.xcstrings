    "calculator.advanced.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default, a full year and a 0% surcharge are used. Months are applied proportionally when the tax liability starts or ends."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Լռելյայն հաշվարկվում է ամբողջ տարին և 0% հավելավճարը։ Ամիսները կիրառվում են համամասնորեն, երբ հարկային պարտավորությունը սկսվում կամ ավարտվում է։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию считаем полный год и надбавку 0%. Месяцы применяются пропорционально при возникновении или прекращении налогового обязательства."
          }
        }
      }
    },
