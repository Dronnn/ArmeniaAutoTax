    "calculator.disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimate under Articles 243–248 of the RA Tax Code. Excludes individual benefits, penalties, environmental tax, insurance and other payments."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գնահատում՝ ՀՀ հարկային օրենսգրքի 243–248 հոդվածներով։ Չեն ներառվում անհատական արտոնությունները, տույժերը, բնապահպանական հարկը, ապահովագրությունը և այլ վճարումները։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценка по ст. 243–248 НК РА. Без индивидуальных льгот, пеней, экологического налога, страховки и других платежей."
          }
        }
      }
    },
