      }
    },
    "calculator.powerSource.evRawNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the raw motor power. The app applies the 2026 EV rule: up to 250 hp ÷ 1.5; above 250 hp: 250 ÷ 1.5 + the rest ÷ 2.5."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մուտքագրեք շարժիչի գործարանային հզորությունը։ Հավելվածը կիրառում է 2026-ի EV կանոնը՝ մինչև 250 ձ. ու. ÷ 1.5, 250-ից բարձր՝ 250 ÷ 1.5 + մնացածը ÷ 2.5։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
