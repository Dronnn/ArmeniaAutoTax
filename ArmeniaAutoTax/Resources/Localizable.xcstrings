    "rules.age.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The year of manufacture and the next two years are taxed at 100%. From the third following year, the tax decreases by 10 percentage points each year, up to 50%."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Թողարկման տարին և հաջորդ երկու տարիները հարկվում են 100%-ով։ Երրորդ հաջորդ տարվանից հարկը տարեկան նվազում է 10 տոկոսային կետով՝ առավելագույնը 50%։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Год выпуска и два следующих года — 100% налога. Начиная с третьего следующего года налог уменьшается на 10 процентных пунктов ежегодно, максимум на 50%."
          }
        }
      }
    },
    "rules.age.cargo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cargo and cargo-passenger vehicles are exempt from the 20th tax year following the year of manufacture."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Բեռնատար և բեռնա-ուղևորատար մեքենաները ազատվում են հարկից թողարկման տարվանից հետո քսաներորդ հարկային տարուց սկսած։"
          }
        },
        "ru" : {
          "stringUnit" : {
